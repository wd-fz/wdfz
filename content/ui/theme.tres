[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="SystemFont" id="Font"]
font_names = PackedStringArray("Noto Sans CJK SC", "Microsoft YaHei", "PingFang SC", "sans-serif")

[sub_resource type="StyleBoxFlat" id="Normal"]
content_margin_left = 20.0
content_margin_top = 12.0
content_margin_right = 20.0
content_margin_bottom = 12.0
bg_color = Color(0.08, 0.13, 0.17, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.33, 0.39, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="Hover"]
content_margin_left = 20.0
content_margin_top = 12.0
content_margin_right = 20.0
content_margin_bottom = 12.0
bg_color = Color(0.13, 0.23, 0.28, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.47, 0.74, 0.73, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="Focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.83, 0.72, 0.43, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[resource]
default_font = SubResource("Font")
default_font_size = 18
Button/styles/normal = SubResource("Normal")
Button/styles/hover = SubResource("Hover")
Button/styles/pressed = SubResource("Hover")
Button/styles/focus = SubResource("Focus")
Button/styles/disabled = SubResource("Normal")
Button/colors/font_color = Color(0.91, 0.95, 0.93, 1)
Button/colors/font_disabled_color = Color(0.42, 0.49, 0.51, 1)
Label/colors/font_color = Color(0.87, 0.93, 0.92, 1)
