[gd_resource type="Resource" script_class="ItemCatalog" load_steps=12 format=3]

[ext_resource type="Script" path="res://content/items/item_catalog.gd" id="Catalog"]
[ext_resource type="Script" path="res://content/items/item_definition.gd" id="Item"]

[sub_resource type="Resource" id="Card"]
script = ExtResource("Item")
item_id = &"card"
display_name = "学生证"
description = "照片上的人我不认识，班号是我们班。"

[sub_resource type="Resource" id="RoomKey"]
script = ExtResource("Item")
item_id = &"roomkey"
display_name = "机房钥匙"
description = "铜的，磨得发亮。塑料标签上写着「机房」。"

[sub_resource type="Resource" id="Chalk"]
script = ExtResource("Item")
item_id = &"chalk"
display_name = "粉笔"
description = "半截。断口很新。"

[sub_resource type="Resource" id="Pen"]
script = ExtResource("Item")
item_id = &"pen"
display_name = "笔"
description = "一支笔。还能写。"

[sub_resource type="Resource" id="Notebook"]
script = ExtResource("Item")
item_id = &"notebook"
display_name = "笔记本"
description = "没写过的本子。有它，想到的事就不会忘。"

[sub_resource type="Resource" id="Torch"]
script = ExtResource("Item")
item_id = &"torch"
display_name = "手电筒"
description = "光很弱。但在地下车库里，它是唯一能定住东西的东西。"

[sub_resource type="Resource" id="CarKey"]
script = ExtResource("Item")
item_id = &"key"
display_name = "钥匙"
description = "一串车钥匙。牌号刻在环上。"

[sub_resource type="Resource" id="Coin"]
script = ExtResource("Item")
item_id = &"coin"
display_name = "硬币"
description = "边缘磨得很圆。食堂窗口和售货机都收；在车库里扔出去会有声音。"

[sub_resource type="Resource" id="Map"]
script = ExtResource("Item")
item_id = &"map"
display_name = "平面图"
description = "边角被翻烂了。能看懂这所学校。"

[resource]
script = ExtResource("Catalog")
items = Array[ExtResource("Item")]([SubResource("Card"), SubResource("RoomKey"), SubResource("Chalk"), SubResource("Pen"), SubResource("Notebook"), SubResource("Torch"), SubResource("CarKey"), SubResource("Coin"), SubResource("Map")])
