extends "res://tests/support/test_suite.gd"

func _app() -> GameApp:
	var app: GameApp=APP.instantiate()
	app.saves=SaveStore.new(_test_path)
	app.settings=GameSettings.new(_test_path.get_base_dir()+"/debug-settings.json")
	root.add_child(app)
	await _frames(2)
	app.wuda_roll=func() -> float: return 1
	app.start_new_game("hard","none")
	app.set_physics_process(false)
	app.player.set_physics_process(false)
	app.debug_flow.set_process(false)
	return app

func test_reference_time() -> void:
	var data: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/debug-time-reference.json"))
	var school:=SchoolModule.new()
	for sample: Dictionary in data.cases:
		school.day=int(sample.day)
		school.tsec=float(sample.time)
		school.rewind_game_time(sample.minutes)
		check(school.day==int(sample.after.day) and absf(school.tsec-sample.after.time)<.000001,"original calendar rewind: %s" % sample)

func test_commands() -> void:
	var app:=await _app()
	var dev:=app.debug_flow
	app._toggle_debug()
	check(app.debug_panel.visible and app.player.enabled and not paused,"opening the expanded tools retains live input and simulation")
	check(app.debug_panel._pages.size()==5 and app.debug_panel._selectors.DevAnomaly.option.item_count==26,"all five developer pages and 26 anomaly entries exist")
	var before:=app.school().capture()
	for value: String in ["","NaN","inf","-1","101","1e309","abc"]:
		dev.command("stat",{"key":"san","value":value})
		check(same_json(before,app.school().capture()),"invalid stat input is rejected: "+value)
	dev.command("stat",{"key":"san","value":"20"})
	check(app.school().san==20 and app.school().stam==52 and not app.runscore().trusted,"editing SAN clamps stamina and marks this run untrusted")
	dev.command("stat",{"key":"stam","value":"100"})
	check(app.school().stam==52,"direct stamina edit obeys current SAN cap")
	dev.command("heal")
	check(app.school().san==100 and app.school().stam==100 and not app.school().tired,"heal clears exhaustion")
	for clock: String in ["x","1:20","7:19","24:00","12:61","1:2:3"]:
		var time:=app.school().tsec
		dev.command("clock",{"value":clock})
		check(app.school().tsec==time,"invalid clock rejected "+clock)
	dev.command("clock",{"value":"00:10"})
	check(app.school().tsec==1450 and app.school().day==2,"setting midnight preserves next-day clock convention")
	var pressure: float=app.school().pressure()["clock"]
	dev.command("time",{"minutes":-800})
	check(app.school().tsec==650 and app.school().day==1 and app.school().pressure()["clock"]>=pressure,"rewind cannot undo accumulated pressure")
	app.school().inspection["queue"]=[{"day":1,"slot":0}]
	var time:=app.school().tsec
	dev.command("time",{"minutes":60})
	check(app.school().tsec==time,"pending inspection blocks clock changes")
	dev.command("inspection_end")
	app.school().tsec=1000
	app.school().inspection["queue"]=[{"day":1,"slot":0}]
	dev.command("time",{"minutes":-300})
	check(app.school().tsec==700 and app.school().inspection["queue"].is_empty(),"stale inspection is pruned before rewind and cannot become live again")
	app.elevator().ride={"host":"teach","origin":1,"phase":"cabin"}
	dev.command("clock",{"value":"12:00"})
	check(app.school().tsec==700,"clock edit cannot detach a live elevator ride")
	app.elevator().cancel()
	app.items().bag=[]
	for id: String in app.items()._items():
		dev.command("item_add",{"id":id})
	check(app.items().bag.size()==8,"developer item grants respect eight-slot capacity")
	var item:=String(app.items().bag[0])
	dev.command("hot2",{"id":item})
	check(app.items().hot[1]==item,"developer hotbar uses inventory rules")
	dev.command("item_remove",{"id":item})
	check(not app.items().has(item) and app.items().hot[1]==null,"removal clears associated hotbar slot")
	var search: LineEdit=app.debug_panel._selectors.DevItem.search
	search.text="不存在的道具"
	search.text_changed.emit(search.text)
	check(app.debug_panel.selected("DevItem")=="" and app.debug_panel._selectors.DevItem.option.disabled,"empty search clears selection instead of acting on stale item")
	dev.command("anomaly",{"id":"leak"})
	check(app.anomaly().active_id()=="leak" and app._campus_world().anomaly_fx.current()=="leak","trigger initializes rule data and draws it immediately")
	var pose:=app.player.capture_pose()
	dev.command("preview",{"id":"grip"})
	check(dev.preview==null and same_json(pose,app.player.capture_pose()),"active anomaly blocks conflicting preview")
	app.ui.show_choice("anomaly",["choose"])
	app.player.enabled=false
	dev.command("anomaly_end")
	check(app.player.enabled and not app.ui.choice_open(),"ending an anomaly choice returns player input")
	dev.command("anomaly",{"id":"leak"})
	app.school().inspection["queue"]=[{"day":1,"slot":0}]
	app.ui.show_choice("pending",["old"])
	app._choice_handler=func(_v: int) -> void: check(false,"cancelled teleport choice must never fire")
	dev.command("teleport",{"id":"lab1"})
	check(app.session.world_id=="lab1" and not app.anomaly().is_active() and not app.school().inspection_pending() and not app.ui.choice_open() and not app._choice_handler.is_valid(),"debug teleport cancels anomaly, inspection and choice logically as well as visually")
	check(app._campus_world().anomaly_fx.current()=="" and app.player.enabled and not app.player.seated,"teleport leaves a controllable standing player and no stale effects")
	dev.command("outdoor",{"id":"8"})
	var w:=CampusGeometry.to_world(null,app.player.position.x,app.player.position.z)
	check(w.distance_to(Vector2(1122,1990))<.001,"outdoor POI retains the original SC=2 coordinates")
	dev.command("fake_normal")
	check(app.fake_normal().fn["on"] and app.fake_normal().fn["next"]==3,"fake-normal tool keeps original initial delay")
	dev.command("fake_normal")
	check(not app.fake_normal().fn["on"] and app._fake_people==null,"fake-normal tool clears its crowd")
	dev.command("inspection")
	check(app.school().inspection_active(),"manual inspection starts immediately outside scheduled time")
	dev.command("inspection_end")
	check(not app.school().inspection_pending(),"manual inspection cancels without pending stale settlement")
	dev.command("freeze")
	check(dev.frozen and app.player.debug_frozen and not paused,"explicit debug freeze is separate from menu pause")
	app.items().add("torch")
	app.items().set_hot(0,"torch")
	app._touch_torch()
	app._touch_hot(0)
	app._open_manual()
	check(not app.items().torch_on and not app.ui.choice_open(),"freeze also blocks touch shortcuts and manuals")
	var t:=app.session.clock.active_seconds
	app._physics_process(1)
	check(app.session.clock.active_seconds==t,"freeze blocks all game simulation")
	app.debug_panel.dismiss()
	check(not dev.frozen and not app.player.debug_frozen and app.player.enabled,"closing tools cannot strand the player frozen")
	dev.command("fast")
	dev.command("god")
	dev.command("search")
	app.start_new_game("hard","none")
	app.set_physics_process(false)
	app.player.set_physics_process(false)
	check(dev.fast and dev.god and dev.instant_search and not app.runscore().trusted,"modifiers survive new game but always invalidate its score")
	app.items().add("elixir")
	app.kill("test","grip","debug")
	check(not app.story().dead and app.items().has("elixir"),"god mode blocks death before consuming rescue items")
	app.items().remove("elixir")
	app.speedrun.arm("hard")
	app.start_new_game("hard","none")
	app.set_physics_process(false)
	app.player.set_physics_process(false)
	check(not dev.fast and not dev.god and not dev.instant_search,"speedrun clears retained modifiers")
	app.speedrun.start()
	dev.command("god")
	check(app.speedrun.run["status"]!="running" and not app.runscore().trusted,"enabling a modifier mid-speedrun invalidates timer and score")
	app.return_to_menu()
	app.queue_free()
	await _frames(3)
	CampusData.clear_caches()

func test_preview_lifecycle() -> void:
	var app:=await _app()
	var dev:=app.debug_flow
	var audio_rng:=app.audio._rng.state
	app._stand_up()
	app.player.set_pitch(.35)
	app.player.rotation.y=.6
	for cause: String in DeathCG.CAUSES:
		var state:=app.session.capture(app.player.capture_pose())
		var view:=app.player.camera.transform
		dev.preview_death(cause)
		check(is_instance_valid(dev.preview) and dev.preview.cam!=app.player.camera,"isolated display camera for "+cause)
		for at: float in [0.0,.5,1.2,2.4]:
			dev.preview.update(at)
			check(same_json(state,app.session.capture(app.player.capture_pose())) and view.is_equal_approx(app.player.camera.transform),"preview preserves saved state, input pitch and real camera: %s at %.1f" % [cause,at])
		dev.clear_preview()
		check(app.audio._rng.state==audio_rng and app.audio._preview_voices.is_empty(),"preview sound is independent and cleaned up: "+cause)
		check(dev.preview==null and app._campus_world().visible and app.player.camera.current,"preview cleanup restores world and active camera: "+cause)
		await _frames()
	dev.preview_death("neck")
	dev._process(100)
	check(dev.preview==null,"preview cleans up automatically at completion")
	dev.preview_death("grip")
	app.travel("lab1",app.campus().default_spawn("lab1"),false)
	check(dev.preview==null and app.player.camera.current and app._campus_world().visible,"ordinary scene changes also cancel preview")
	dev.preview_death("shadow")
	app.save_game()
	app.load_game()
	app.set_physics_process(false)
	app.player.set_physics_process(false)
	check(dev.preview==null and app.player.camera.current,"load cancels preview without applying its view to saved pose")
	var before:=app.player.capture_pose()
	dev.preview_death("follow")
	app.kill("debug","grip","debug")
	check(app.story().dead and dev.preview==null,"real death cancels running preview before starting death camera")
	if app._death_cg!=null: app._death_cg.update(2.4)
	dev.revive()
	check(not app.story().dead and app._death_phase=="" and app._death_cg==null and app.player.enabled and same_json(before,app.player.capture_pose()),"revive restores pre-death input pose and cancels pending death card")
	app._death_step(100)
	check(app._death_phase=="" and not app.story().dead,"old death timeline cannot fire after revival")
	dev.preview_death("trash")
	app.start_new_game("hard","none")
	app.set_physics_process(false)
	app.player.set_physics_process(false)
	check(dev.preview==null and app._campus_world().visible,"new game cancels hidden-world preview")
	dev.preview_death("liftdoor")
	app.return_to_menu()
	check(dev.preview==null and dev.preview_camera==null,"return to menu releases all preview nodes")
	app.queue_free()
	await _frames(3)
	CampusData.clear_caches()
