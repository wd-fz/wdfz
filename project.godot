; Open this directory in Godot 4.6.3 (standard edition, GDScript).
config_version=5

[application]
config/name="武大附中 · 里世界 — Godot 移植版"
config/description="探索校园、遵守规则，寻找里世界的出口。"
config/version="0.2.1"
config/icon="res://assets/branding/icon.svg"
run/main_scene="res://game/app/app.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="wdfz-godot"

[threading]
; Keep shader compilation from being starved by Mobile pipeline jobs on small CPU pools.
; Temporary mitigation for Godot #123060; validated with cold-cache archive regression.
worker_pool/max_threads=8

[display]
display_server/driver.linuxbsd="wayland"
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/mode.android=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/driver.windows="vulkan"
rendering_device/driver.android="vulkan"
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.065, 1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
lift_close={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":86)]}
bag={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194306)]}
hot_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
hot_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
torch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
lesson={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
notes={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":78)]}
think={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":72)]}
mute={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
