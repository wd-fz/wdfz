 "items": {
  "card": {
   "n": "学生证",
   "d": "照片上的人我不认识，班号是我们班。"
  },
  "phone": {
   "n": "手机",
   "d": "可以查看网络工具，也能玩纸飞机。电量有限；回原教室充电，或连接机房电脑。收起后后台任务继续。"
  },
  "chalk": {
   "n": "粉笔",
   "d": "半截。断口很新。"
  },
  "map": {
   "n": "平面图",
   "d": "边角被翻烂了。能看懂这所学校。"
  },
  "key": {
   "n": "钥匙",
   "d": "一串车钥匙。牌号刻在环上。"
  },
  "torch": {
   "n": "手电筒",
   "d": "光很弱。但在地下车库里，它是唯一能定住东西的东西。"
  },
  "brolly": {
   "n": "雨伞",
   "d": "伞骨断了一根，还能撑。"
  },
  "coat": {
   "n": "校服外套",
   "d": "比我穿的那件大一号。"
  },
  "pill": {
   "n": "药片",
   "d": "名字被撕掉了。吃下去后 30 秒内，视野和呼吸逐渐回稳。再吃一片会重新计时。"
  },
  "notebook": {
   "n": "笔记本",
   "d": "没写过的本子。有它，想到的事就不会忘。"
  },
  "pen": {
   "n": "笔",
   "d": "一支笔。还能写。"
  },
  "snack": {
   "n": "士力架",
   "d": "压在卷子底下的一条。吃下去，30 个运行秒内，步行和奔跑速度变为 1.5 倍，疾跑不耗体力。"
  },
  "battery": {
   "n": "电池",
   "d": "两节。外壳上写着日期，很旧了。"
  },
  "compass": {
   "n": "罗盘",
   "d": "指针不指北——指向最近的那扇门。"
  },
  "metronome": {
   "n": "节拍器",
   "d": "摆锤自己在动，可是没有声音。"
  },
  "goggles": {
   "n": "护目镜",
   "d": "镜片上有洗不掉的斑点。戴着它摆弄离心机、显微镜，手会稳一些。"
  },
  "hw": {
   "n": "作业本",
   "d": "写完了的作业。字很工整，不是我的。"
  },
  "coin": {
   "n": "硬币",
   "d": "边缘磨得很圆。食堂窗口和售货机都收；在车库里扔出去会有声音。"
  },
  "usb": {
   "n": "U 盘",
   "d": "上面贴着「门禁」两个字。"
  },
  "watch": {
   "n": "手表",
   "d": "能看现在的时间，精确到分钟。"
  },
  "memo": {
   "n": "纸条",
   "d": "上面写着门禁和白名单的事。"
  },
  "roomkey": {
   "n": "机房钥匙",
   "d": "铜的，磨得发亮。塑料标签上写着「机房」。"
  },
  "coil": {
   "n": "铜线圈",
   "d": "从服务器里抽出来的一卷。缠得很密，摸上去一直在发烫。（传送门材料）"
  },
  "lens": {
   "n": "透镜",
   "d": "显微镜上拧下来的物镜。透过它看，墙后面像是还有一层。（传送门材料）"
  },
  "vial": {
   "n": "荧光试剂",
   "d": "离心机甩出来的一管，颜色一直在变。（传送门材料）"
  },
  "atlas": {
   "n": "建筑总览图",
   "d": "每栋楼每一层都画在上面。有几处用红笔圈着。"
  },
  "elixir": {
   "n": "不知名药丸",
   "d": "没有说明书的一粒。要死的时候，它会把你拽回来一次。"
  },
  "seal": {
   "n": "符纸",
   "d": "折成三角的黄纸。附近巡察者即将锁定时自动烧掉，使它消失三十秒。不会撤销已登记的责任。"
  },
  "leave": {
   "n": "请假条",
   "d": "班主任签过字，日期空着。用了能请两个小时的假：这段时间不用待在规定的地方，普通巡察不管你；不能豁免检查或解除持续追踪。违规记满了就批不下来。"
  },
  "paper": {
   "n": "纸飞机",
   "d": "从窗口飞进来的。拆开是一张写了字的纸。"
  },
  "medkit": {
   "n": "急救包",
   "d": "绷带、碘伏和一卷胶布。包扎要蹲下来 4 秒，别动。"
  },
  "small_knife": {
   "n": "小刀",
   "d": "折叠的，刃口有点钝。"
  },
  "top": {
   "n": "陀螺",
   "d": "铜的，底下磨得很亮。在桌上转，它总会倒。"
  },
  "archivekey": {
   "n": "教导处钥匙",
   "d": "五楼办公室的钥匙，标签上写着「教导处通知档案」。"
  },
  "broadcastkey": {
   "n": "广播站钥匙",
   "d": "保安岗登记簿里的钥匙，能打开行政楼二楼广播站。"
  },
  "broadcastfuse": {
   "n": "备用保险丝",
   "d": "体育器材室的备用件，可以修复广播站功放。"
  },
  "notice_fake": {
   "n": "红笔通知稿",
   "d": "红笔，第 0 天。「请读到这里的同学留在原地。」"
  },
  "notice1": {
   "n": "放学通知 · 残页1",
   "d": "蓝黑墨水，第二天。第二天，第八节下课以后。请全体同学收好课本。"
  },
  "notice2": {
   "n": "放学通知 · 残页2",
   "d": "蓝黑墨水，第二天。第二天。请核对蓝黑墨水的通知，不要念红色的那一页。"
  },
  "notice3": {
   "n": "放学通知 · 残页3",
   "d": "蓝黑墨水，第二天。第二天。听到长铃后，随同学们从北门离校。"
  },
  "notice4": {
   "n": "放学通知 · 残页4",
   "d": "蓝黑墨水，第二天。第二天。铃声结束前离校，明天见。"
  }
