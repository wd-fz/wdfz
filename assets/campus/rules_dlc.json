{
  "rules": [
    {
      "id": "R01",
      "carrier": "纸飞机内页",
      "text": "有两次敲窗声的纸，要从来时那扇窗回去。\n不要让它在墙上留下折痕。",
      "t": "true"
    },
    {
      "id": "R02",
      "carrier": "窗框内侧的标签",
      "text": "听见窗后呼吸，低头退到立柱后。\n不要确认是谁。",
      "t": "true",
      "where": {
        "room": "admin2",
        "win": 2
      }
    },
    {
      "id": "R03",
      "carrier": "桌沿的铅笔字",
      "text": "看见它以后，低头就行。\n走开前一定要回头确认。",
      "t": "half",
      "where": {
        "room": "teach2",
        "ch": "P",
        "k": 0
      }
    },
    {
      "id": "R04",
      "carrier": "学生证背面的小纸条",
      "text": "带着这张卡，检查时站在走廊也算在座。",
      "t": "false",
      "where": {
        "room": "canteen1",
        "ch": "t",
        "k": 6
      }
    },
    {
      "id": "R05",
      "carrier": "宿舍床板上的刻字",
      "text": "熄灯后的第三声敲门不是来查寝的。\n请不要替上铺答应。",
      "t": "true",
      "where": {
        "room": "dorm1",
        "ch": "b",
        "k": 0
      }
    },
    {
      "id": "R06",
      "carrier": "食堂收据背面",
      "text": "多出来的那份不是赠送。原样放回托盘即可；\n食堂关门以后也一样。",
      "t": "half",
      "where": {
        "room": "canteen1",
        "ch": "t",
        "k": 12
      }
    },
    {
      "id": "R07",
      "carrier": "电脑边的便笺",
      "text": "没有信号的手机最安全，不可能告诉它你在哪。",
      "t": "false",
      "where": {
        "room": "lab3",
        "ch": "n",
        "k": 0
      }
    },
    {
      "id": "R08",
      "carrier": "连廊检修牌",
      "text": "接到来历不明的纸，先找窗号。\n看不清来处时不要替别人寄。",
      "t": "true",
      "where": {
        "room": "link2",
        "ch": ".",
        "k": 4
      }
    },
    {
      "id": "R09",
      "carrier": "借书卡里夹的纸",
      "text": "所有手写字都是假的。",
      "t": "false",
      "where": {
        "room": "admin3",
        "ch": "d",
        "k": 3
      }
    },
    {
      "id": "R10",
